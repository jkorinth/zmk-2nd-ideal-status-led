menuconfig ZMK_2NDIDEAL_STATUS_LED
	bool "Custom status LED (takes over RGB underglow)"
	select LED_STRIP
	default n

if ZMK_2NDIDEAL_STATUS_LED

config ZMK_RGB_UNDERGLOW
	default n

config ZMK_2NDIDEAL_STATUS_LED_BRIGHTNESS
	int "Single channel brightness (0-255)"
	default 32

config ZMK_2NDIDEAL_STATUS_LED_TEST
	bool "Run WS2812B pixel test walk on boot"
	default n

config ZMK_2NDIDEAL_STATUS_LED_TEST_DELAY_MS
	int "Delay between test-walk steps (ms)"
	default 150
	depends on ZMK_2NDIDEAL_STATUS_LED_TEST

config ZMK_2NDIDEAL_BL_RESET
	bool "One-shot: reset stored per-LED backlight colors to defaults on next boot"
	default n
	help
	  Enable this, build, and flash once to discard whatever is currently
	  persisted under settings key "bl/leds" and rewrite it with the
	  compiled-in defaults. Disable this and reflash again afterward —
	  leaving it enabled resets the stored colors back to defaults on
	  every boot.

endif # ZMK_2NDIDEAL_STATUS_LED

config ZMK_BEHAVIOR_STATUS_LED
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_STATUS_LED_ENABLED

if ZMK_BEHAVIOR_STATUS_LED
endif #ZMK_BEHAVIOR_STATUS_LED

config ZMK_BEHAVIOR_BL_SELECT
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_BL_SELECT_ENABLED

config ZMK_BEHAVIOR_BL_ADJUST
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_BL_ADJUST_ENABLED

config ZMK_BEHAVIOR_BL_COMMIT
	bool
	default y
	depends on DT_HAS_ZMK_BEHAVIOR_BL_COMMIT_ENABLED
